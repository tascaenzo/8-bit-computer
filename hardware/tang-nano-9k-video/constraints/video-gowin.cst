IO_LOC "tmds_clk_p" 69,68;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;

// BOOT_RUN on J6-2 is a 1.8 V bank: use U4 then the documented 3.3 V / 1.8 V divider.
IO_LOC "boot_run" 86;
IO_PORT "boot_run" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
